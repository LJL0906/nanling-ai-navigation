---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

const { site: SITE } = await Astro.locals.getRuntimeSettings();

Astro.response.status = 404;

const description = '您访问的页面不存在或已被移除，返回首页继续浏览精选网站导航。';
---
<BaseLayout
  title={`页面不存在 - ${SITE.name}`}
  description={description}
  canonical={`${SITE.url}/404/`}
  robots="noindex,follow"
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__visual" aria-hidden="true">
      <span class="not-found__code">404</span>
      <span class="not-found__compass">
        <Icon name="lucide:compass" width={32} height={32} />
      </span>
    </div>
    <p class="text-xs font-medium tracking-[0.2em] text-brand-600 dark:text-brand-300">暂时迷路，不妨换个方向</p>
    <h1 id="not-found-title" class="mt-4 text-2xl font-bold tracking-tight text-ink-900 sm:text-3xl dark:text-white">
      抱歉，这个页面不见了
    </h1>
    <p class="mt-4 max-w-md text-sm leading-7 text-ink-500 dark:text-white/65">
      您访问的页面可能已被移除，或链接地址有误。<br class="hidden sm:block" />
      回到首页，或从分类出发，继续发现值得收藏的好网站。
    </p>
    <div class="not-found__actions">
      <Button href="/" class="min-h-11 w-full gap-2 sm:w-auto sm:min-w-40">
        <Icon name="lucide:house" width={18} height={18} aria-hidden="true" />
        返回首页
      </Button>
      <Button href="/categories/" variant="soft" class="min-h-11 w-full gap-2 sm:w-auto sm:min-w-40">
        <Icon name="lucide:layout-grid" width={18} height={18} aria-hidden="true" />
        浏览分类
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: max(560px, calc(100svh - 210px));
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 56px 16px 72px;
    text-align: center;
  }

  .not-found__visual {
    position: relative;
    display: grid;
    width: min(100%, 460px);
    place-items: center;
    margin-bottom: 32px;
    isolation: isolate;
  }

  .not-found__visual::before {
    position: absolute;
    z-index: -1;
    inset: -24% -4%;
    border-radius: 50%;
    background: radial-gradient(ellipse, var(--color-brand-100), transparent 68%);
    content: '';
  }

  .not-found__code {
    color: var(--color-brand-500);
    font-size: clamp(112px, 19vw, 200px);
    font-weight: 800;
    letter-spacing: -0.065em;
    line-height: 1.05;
    padding-right: 0.065em;
    text-shadow: 0 10px 32px rgb(55 119 245 / 12%);
  }

  .not-found__compass {
    position: absolute;
    right: 8%;
    bottom: -8px;
    display: grid;
    width: 60px;
    height: 60px;
    place-items: center;
    border: 1px solid var(--color-brand-100);
    border-radius: 20px;
    background: var(--color-surface);
    color: var(--color-brand-500);
    box-shadow: 0 12px 28px -12px rgb(55 119 245 / 25%);
    transform: rotate(12deg);
  }

  .not-found__actions {
    display: flex;
    width: 100%;
    max-width: 360px;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  :global(.dark) .not-found__visual::before {
    background: radial-gradient(ellipse, rgb(55 119 245 / 16%), transparent 68%);
  }

  :global(.dark) .not-found__code { color: var(--color-brand-400); }

  :global(.dark) .not-found__compass {
    border-color: rgb(169 192 249 / 18%);
    background: #19243b;
    color: var(--color-brand-300);
  }

  @media (max-width: 639px) {
    .not-found {
      min-height: calc(100svh - 190px);
      padding: 40px 4px 48px;
    }

    .not-found__visual { max-width: 300px; }
    .not-found__compass { width: 48px; height: 48px; border-radius: 16px; }
    .not-found__actions { max-width: 280px; flex-direction: column; }
  }
</style>
