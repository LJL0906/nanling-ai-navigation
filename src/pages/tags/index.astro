---
/** 标签目录与分类页复用同一份动态细分，链接直接进入服务端筛选结果。 */
import BaseLayout from '../../layouts/BaseLayout.astro';
const { site: SITE } = await Astro.locals.getRuntimeSettings();
import { getNavigation } from '../../lib/data';
import { createWebsiteNode, breadcrumb, itemList } from '../../lib/seo';
import { buildCategoryFacets } from '../../lib/category-facets';
import BrandIcon from '../../components/ui/BrandIcon.astro';

const { categories, siteCount } = await getNavigation();
const groups = categories.map(category => ({ category, facets: buildCategoryFacets(category).filter(facet => facet.key !== 'all') }));
const href = (slug: string, key: string) => `/${slug}/?sub=${encodeURIComponent(key)}`;
const canonical = `${SITE.url}/tags/`;
const title = `标签导航 | ${SITE.name}`;
const description = `按真实标签浏览 ${SITE.name} 收录的 ${siteCount} 个网站，覆盖 ${categories.length} 个分类。`;
const ld = [
  createWebsiteNode(SITE),
  breadcrumb([{ name: '首页', url: `${SITE.url}/` }, { name: '标签导航', url: canonical }]),
  itemList('标签分类目录', categories.map(category => ({ name: category.name, url: `${SITE.url}/${category.slug}/` }))),
];
---
<BaseLayout title={title} description={description} canonical={canonical} ld={ld}>
  <h1 class="text-xl font-bold tracking-tight text-ink-900 dark:text-white">标签导航</h1>
  <p class="mt-2 text-sm text-ink-400 dark:text-white/60">根据站点标签与来源分类实时整理，点击标签查看对应站点。</p>
  <div class="mt-6 space-y-7">
    {groups.map(({ category, facets }) => (
      <section aria-labelledby={`tag-${category.slug}`}>
        <div class="flex items-center gap-2.5">
          <BrandIcon icon={category.icon} color={category.color} size={30} />
          <h2 id={`tag-${category.slug}`} class="text-sm font-semibold text-ink-900 dark:text-white">
            <a href={`/${category.slug}/`} class="transition-colors hover:text-brand-500">{category.name}</a>
          </h2>
          <span class="text-[11px] text-ink-300 dark:text-white/40">{category.sites.length} 个站点</span>
        </div>
        <ul class="mt-3 flex flex-wrap gap-2">
          {facets.map(facet => (
            <li><a href={href(category.slug, facet.key)} class="inline-flex min-h-8 items-center gap-2 rounded-lg bg-chip px-3 py-1 text-xs text-ink-500 transition hover:bg-brand-50 hover:text-brand-600 dark:bg-white/10 dark:text-white/70 dark:hover:bg-brand-500/20">
              {facet.label}<span class="opacity-60">{facet.indices.length}</span>
            </a></li>
          ))}
        </ul>
        {!facets.length && <p class="mt-3 text-sm text-ink-400">该分类暂无可用标签，可点击分类名称查看全部站点。</p>}
      </section>
    ))}
  </div>
</BaseLayout>
