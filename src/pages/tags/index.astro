---
/** Tag 导航：把全部分类与站点名铺开，便于按标签跳转。 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { categories, siteCount } from '../../lib/data';
import { websiteNode, breadcrumb, itemList } from '../../lib/seo';
import BrandIcon from '../../components/ui/BrandIcon.astro';

const canonical = `${SITE.url}/tags/`;
const title = `Tag 导航_标签索引 | ${SITE.name}`;
const description = `按标签浏览 ${SITE.name} 收录的 ${siteCount} 个网站，覆盖 ${categories.length} 个分类。`;
const ld = [
  websiteNode,
  breadcrumb([
    { name: '首页', url: `${SITE.url}/` },
    { name: 'Tag 导航', url: canonical },
  ]),
  itemList(
    '标签索引',
    categories.map((c) => ({ name: c.name, url: `${SITE.url}/${c.slug}/` }))
  ),
];
---
<BaseLayout title={title} description={description} canonical={canonical} ld={ld}>
  <h1 class="text-xl font-bold tracking-tight text-ink-900 dark:text-white">Tag 导航</h1>
  <p class="mt-1.5 text-[13px] text-ink-400 dark:text-white/55">{description}</p>

  <div class="mt-6 space-y-7">
    {categories.map((cat) => (
      <section aria-labelledby={`tag-${cat.slug}`}>
        <div class="flex items-center gap-2.5">
          <BrandIcon icon={cat.icon} color={cat.color} size={30} />
          <h2 id={`tag-${cat.slug}`} class="text-sm font-semibold text-ink-900 dark:text-white">
            <a href={`/${cat.slug}/`} class="transition-colors hover:text-brand-500">{cat.name}</a>
          </h2>
          <span class="text-[11px] text-ink-300 dark:text-white/40">{cat.sites.length} 个</span>
        </div>
        <ul class="mt-3 flex flex-wrap gap-2">
          {cat.sites.map((site) => (
            <li>
              <a
                href={`/${cat.slug}/${site.slug}/`}
                class="inline-flex h-8 items-center rounded-lg bg-chip px-3 text-xs text-ink-500 transition hover:bg-brand-50 hover:text-brand-600 dark:bg-white/10 dark:text-white/70 dark:hover:bg-brand-500/20"
              >
                {site.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
