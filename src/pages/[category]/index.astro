---
import { getNavigation } from '../../lib/data';
import CategoryPage from '../../components/category/CategoryPage.astro';

export const prerender = false;

const { categories } = await getNavigation();
const category = categories.find((item) => item.slug === Astro.params.category);
if (!category) {
  return Astro.rewrite('/404/');
}
---
<CategoryPage category={category} page={1} />

