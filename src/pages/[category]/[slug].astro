---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNavigation, domainOf, relatedSites } from '../../lib/data';
import { createWebsiteNode, breadcrumb, itemList } from '../../lib/seo';
import { Icon } from 'astro-icon/components';
import SiteCard from '../../components/home/SiteCard.astro';
import FavoriteButton from '../../components/ui/FavoriteButton.astro';
import Button from '../../components/ui/Button.astro';
import BrandIcon from '../../components/ui/BrandIcon.astro';

const { site: SITE } = await Astro.locals.getRuntimeSettings();

export const prerender = false;

const { categories, siteRedirects } = await getNavigation();
const { category: categorySlug, slug } = Astro.params;
// 在查找当前分类前匹配历史路径，保留已改名、重分类站点的永久跳转。
const redirect = siteRedirects.find(({ from }) => from === `/${categorySlug}/${slug}/`);
if (redirect) return Astro.redirect(redirect.to, 301);
const category = categories.find((item) => item.slug === categorySlug);
const site = category?.sites.find((item) => item.slug === slug);
if (!category || !site) {
  return Astro.rewrite('/404/');
}
const canonical = `${SITE.url}/${category.slug}/${site.slug}/`;
// 同名站点按真实域名区分；同域不同入口再展示路径，不使用序号伪造独特内容。
const sameNames = category.sites.filter((item) => item.name === site.name);
const sourceLabel = sameNames.filter((item) => item.domain === site.domain).length > 1
  ? site.url.replace(/^https?:\/\//, '') : domainOf(site);
const nameLabel = sameNames.length > 1 ? `${site.name}（${sourceLabel}）` : site.name;
const title = `${nameLabel}网站入口 | ${category.name} - ${SITE.name}`;
const description = `${nameLabel}：${site.desc} 收录于${SITE.name}「${category.name}」分类，提供网站入口及同类网站。`;
const related = relatedSites(category, site);
const detailHref = (item: typeof site) => `/${item.categorySlug}/${item.slug}/`;
const tags = [...new Set(site.tags.map((tag) => tag.trim()).filter(Boolean))];
const aliases = [...new Set(site.aliases.map((alias) => alias.trim()).filter((alias) => alias && alias !== site.name))];

const ld = [
  createWebsiteNode(SITE),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    name: title,
    url: canonical,
    description,
    inLanguage: 'zh-CN',
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: {
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description: site.desc,
      ...(aliases.length ? { alternateName: aliases } : {}),
      ...(tags.length ? { keywords: tags.join(',') } : {}),
    },
  },
  breadcrumb([
    { name: '首页', url: `${SITE.url}/` },
    { name: category.name, url: `${SITE.url}/${category.slug}/` },
    { name: site.name, url: canonical },
  ]),
  ...(related.length ? [itemList('同类推荐', related.map((item) => ({
    name: item.name, url: `${SITE.url}${detailHref(item)}`,
  })))] : []),
];
---
<BaseLayout
  title={title}
  description={description}
  keywords={`${site.name},${site.name}官网,${category.keywords}`}
  canonical={canonical}
  ld={ld}
>
  <nav class="flex items-center gap-1.5 text-xs text-ink-300 dark:text-white/40" aria-label="面包屑">
    <a href="/" class="transition-colors hover:text-brand-500">首页</a>
    <Icon name="lucide:chevron-right" style="width:13px;height:13px" />
    <a href={`/${category.slug}/`} class="transition-colors hover:text-brand-500">{category.name}</a>
    <Icon name="lucide:chevron-right" style="width:13px;height:13px" />
    <span class="text-ink-500 dark:text-white/70">{site.name}</span>
  </nav>

  <article data-site-id={site.id} data-detail-visit
    class="mt-4 flex flex-col gap-5 rounded-2xl border border-hairline bg-linear-to-br from-white to-[#f7f8fc] p-6 sm:flex-row sm:items-center dark:border-white/10 dark:from-white/5 dark:to-white/[0.02]"
  >
    <BrandIcon icon={site.icon} mono={site.mono ?? site.name.charAt(0)} color={site.color} size={72} />
    <div class="min-w-0 flex-1">
      <h1 class="text-xl font-bold tracking-tight text-ink-900 dark:text-white">{site.name}</h1>
      <p class="mt-1 text-xs text-ink-300 dark:text-white/45">{domainOf(site)}</p>
      <p class="mt-2.5 text-[13px] leading-relaxed text-ink-400 dark:text-white/55">
        {site.desc}
      </p>
      <dl class="mt-3 space-y-1 text-xs leading-relaxed text-ink-400 dark:text-white/55">
        <div><dt class="inline">收录分类：</dt><dd class="inline"><a href={`/${category.slug}/`} class="hover:text-brand-500">{category.name}</a></dd></div>
        <div><dt class="inline">官网地址：</dt><dd class="inline break-all"><a href={site.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500">{site.url}</a></dd></div>
        {aliases.length > 0 && <div><dt class="inline">别名：</dt><dd class="inline">{aliases.join('、')}</dd></div>}
        {tags.length > 0 && <div><dt class="inline">收录标签：</dt><dd class="inline">{tags.join('、')}</dd></div>}
      </dl>
      {site.verification.status === 'unverified' && <p class="mt-3 text-xs leading-relaxed text-ink-300 dark:text-white/45">收录信息尚未核验，链接、功能及服务条款请以目标网站实际展示为准。</p>}
    </div>
    <FavoriteButton siteId={site.id} name={site.name} />
    <Button href={site.url} external class="shrink-0">
      访问官网
      <Icon name="lucide:external-link" style="width:14px;height:14px" />
    </Button>
  </article>

  {related.length > 0 && (
    <>
      <h2 class="mt-8 mb-4 text-[17px] font-semibold text-ink-900 dark:text-white">同类推荐</h2>
      <ul class="nav-card-grid">
        {related.map((item) => (
          <li>
            <SiteCard site={item} />
            <a href={detailHref(item)} class="mt-1 inline-block text-xs text-ink-400 hover:text-brand-500 dark:text-white/55">查看 {item.name} 详情</a>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
