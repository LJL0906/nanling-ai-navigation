---
// 只渲染静态弹窗；会话由客户端读取，不在 SSR 或 seed 构建期间访问数据库。
---
<dialog data-account-dialog aria-labelledby="account-dialog-title" class="account-dialog">
  <div class="account-dialog-body">
    <button type="button" data-account-close aria-label="关闭登录注册窗口" class="account-dialog-close">×</button>
    <h2 id="account-dialog-title" class="sr-only">登录账号</h2>
    <div class="account-dialog-modes" role="group" aria-label="选择登录或注册">
      <button type="button" data-account-mode="login" aria-pressed="true">登录</button>
      <button type="button" data-account-mode="register" aria-pressed="false">注册</button>
    </div>
    <form data-account-form="login" data-account-modal method="post" action="/api/account/session">
      <label for="dialog-account-username">用户名</label>
      <input id="dialog-account-username" name="username" required minlength="3" maxlength="32" pattern="[A-Za-z0-9_]{3,32}" autocomplete="username" autocapitalize="none" spellcheck="false" title="3–32 位字母、数字或下划线" />
      <label for="dialog-account-password">密码</label>
      <input id="dialog-account-password" name="password" type="password" required minlength="10" maxlength="128" autocomplete="current-password" title="10–128 个字符" />
      <button type="submit" data-account-submit>登录</button>
      <p data-account-message role="status" aria-live="polite"></p>
    </form>
  </div>
</dialog>
<style>
  .account-dialog { position: fixed; inset: 0; margin: auto; width: min(440px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; padding: 0; border: 1px solid #e5e7eb; border-radius: 24px; background: #fff; color: #172033; box-shadow: 0 24px 80px #0004; }
  .account-dialog::backdrop { background: #0f172a80; backdrop-filter: blur(5px); }
  .account-dialog-body { position: relative; padding: 30px; }
  .account-dialog-close { position: absolute; top: 12px; right: 14px; width: 36px; height: 36px; border-radius: 50%; font-size: 26px; line-height: 1; }
  .account-dialog-close:hover { background: #94a3b81a; }
  .account-dialog-modes { display: flex; gap: 4px; margin: 16px 0 22px; padding: 4px; border-radius: 12px; background: #f1f5f9; }
  .account-dialog-modes button { flex: 1; border-radius: 9px; padding: 9px; font-size: 14px; }
  .account-dialog-modes button[aria-pressed="true"] { background: #fff; color: #4f46e5; box-shadow: 0 1px 4px #0001; }
  label { display: block; margin: 15px 0 7px; font-size: 14px; font-weight: 500; }
  input { width: 100%; border: 1px solid #cbd5e1; border-radius: 12px; padding: 12px 14px; background: transparent; font-size: 16px; }
  input:focus-visible, button:focus-visible { outline: 2px solid #818cf8; outline-offset: 3px; }
  [data-account-message] { margin-top: 12px; color: #64748b; font-size: 12px; line-height: 1.7; }
  [data-account-message]:empty { display: none; }
  [data-account-message][data-error="true"] { color: #dc2626; }
  [data-account-submit] { width: 100%; margin-top: 20px; padding: 12px; border-radius: 12px; background: #6366f1; color: #fff; font-weight: 600; }
  button:disabled, input:disabled { opacity: .55; cursor: wait; }
  :global(.dark) .account-dialog { background: #111827; color: #f8fafc; border-color: #334155; }
  :global(.dark) .account-dialog-modes { background: #1e293b; }
  :global(.dark) .account-dialog-modes button[aria-pressed="true"] { background: #334155; color: #c7d2fe; }
  :global(.dark) input { border-color: #475569; }
  :global(.dark) [data-account-message] { color: #a4afc2; }
  :global(.dark) [data-account-message][data-error="true"] { color: #fca5a5; }
  @media (max-width: 480px) { .account-dialog-body { padding: 26px 20px; } }
</style>
<script>import '../../scripts/account-dialog';</script>
