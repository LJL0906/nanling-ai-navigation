---
import { Icon } from 'astro-icon/components';
---
<div class="nav-search" data-nav-search>
  <form class="nav-search__form" action="/search/" method="get" role="search" data-search-history-form>
    <label for="nav-search-input" class="sr-only">搜索网站、工具、资源</label>
    <input id="nav-search-input" name="q" type="search" required placeholder="搜索网站、工具…" autocomplete="off" />
    <button type="submit" class="nav-search__button" aria-label="搜索" title="搜索">
      <Icon name="lucide:search" style="width:16px;height:16px" />
    </button>
  </form>
  <details class="nav-search__history" data-dropdown data-history-popover>
    <summary class="nav-search__button" aria-label="搜索历史" title="搜索历史">
      <Icon name="lucide:history" style="width:16px;height:16px" />
    </summary>
    <div class="nav-search__panel" aria-label="搜索历史记录">
      <p class="nav-search__heading">搜索历史</p>
      <div data-search-history>
        <div class="nav-search__items" data-search-history-tags></div>
      </div>
      <p class="nav-search__empty" data-search-history-empty>暂无搜索记录</p>
    </div>
  </details>
</div>

<style>
  .nav-search {
    display: flex; align-items: center; position: relative; flex: 0 1 300px;
    width: clamp(160px, 21vw, 300px); min-width: 0; max-width: 300px; height: 34px; margin-left: auto; margin-right: 8px;
    border: 1px solid rgb(100 116 139 / .18); border-radius: 999px;
    background: rgb(255 255 255 / .7); color: var(--color-ink-500);
  }
  .nav-search:focus-within { border-color: var(--color-brand-300); }
  .nav-search__form { display: flex; align-items: center; flex: 1; min-width: 0; padding-left: 12px; }
  input { width: 100%; min-width: 0; height: 32px; background: transparent; border: 0; font-size: 12px; outline: none; }
  input:focus-visible { outline: none; }
  .nav-search__button { display: grid; place-items: center; width: 30px; height: 30px; flex: none; padding: 0; border-radius: 50%; cursor: pointer; list-style: none; }
  .nav-search__button:hover { background: rgb(55 119 245 / .08); color: var(--color-brand-500); }
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ''; }
  .nav-search__history { flex: none; padding-right: 2px; }
  .nav-search__panel {
    position: absolute; top: calc(100% + 10px); right: 0; z-index: 50;
    width: 300px; max-width: calc(100vw - 32px); padding: 14px;
    border: 1px solid rgb(255 255 255 / .8); border-radius: 14px;
    background: rgb(248 251 255 / .98); box-shadow: 0 14px 36px rgb(39 57 91 / .16);
    backdrop-filter: blur(20px);
  }
  .nav-search__heading { margin: 0 0 10px; font-size: 12px; font-weight: 600; }
  .nav-search__items { display: flex; flex-wrap: wrap; gap: 7px; font-size: 12px; }
  .nav-search__empty { font-size: 12px; color: var(--color-ink-300); }
  :global(.dark) .nav-search { background: rgb(255 255 255 / .05); border-color: rgb(255 255 255 / .12); color: #c0cadd; }
  :global(.dark) .nav-search__panel { background: rgb(22 32 50 / .98); border-color: rgb(255 255 255 / .1); }
  @media (max-width: 767px) {
    /* 移动端以顶部导航作为定位容器，避免固定宽度的面板从搜索框左侧溢出。 */
    .nav-search { position: static; }
    .nav-search__panel {
      left: 10px; right: 10px; width: auto; max-width: none;
      max-height: min(360px, calc(100dvh - 100px)); overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
  @media (max-width: 639px) { .nav-search { width: 100%; margin-left: auto; margin-right: 4px; flex-basis: 180px; } }
</style>


