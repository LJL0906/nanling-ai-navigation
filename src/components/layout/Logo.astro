---
/** 统一使用 public/logo.png，确保侧栏与站点元信息使用同一份 Logo 资产。 */
interface Props {
  size?: number;
  class?: string;
}

const { site } = await Astro.locals.getRuntimeSettings();
const { size = 40, class: className } = Astro.props;
---
<img src="/logo.png" width={size} height={size} class={className} alt={`${site.name} Logo`} />

