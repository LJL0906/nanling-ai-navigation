---
/** 主按钮 / 次按钮。有 href 渲染 <a>，否则 <button>。 */
interface Props {
  href?: string;
  variant?: 'primary' | 'soft' | 'ghost';
  size?: 'sm' | 'md';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  class: cls = '',
  ariaLabel,
} = Astro.props;

const sizes = { sm: 'h-8 px-3 text-xs', md: 'h-10 px-5 text-sm' };
const variants = {
  primary: 'bg-brand-500 text-white hover:bg-brand-600 shadow-[0_6px_16px_-8px_rgba(55,119,245,0.7)]',
  soft: 'bg-brand-50 text-brand-600 hover:bg-brand-100 dark:bg-brand-500/15 dark:text-brand-300',
  ghost: 'text-ink-500 hover:bg-chip dark:text-white/70 dark:hover:bg-white/10',
};
const Tag = href ? 'a' : 'button';
---
<Tag
  class:list={[
    'inline-flex items-center justify-center gap-1.5 rounded-lg font-medium transition',
    sizes[size],
    variants[variant],
    cls,
  ]}
  href={href}
  type={href ? undefined : type}
  aria-label={ariaLabel}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</Tag>
