---
/** 分区标题 + 右侧「更多」链接。 */
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  moreHref?: string;
  moreLabel?: string;
  id?: string;
}
const { title, moreHref, moreLabel = '更多', id } = Astro.props;
---
<div class="mb-4 flex items-end justify-between gap-4">
  <h2 id={id} class="text-[17px] font-semibold tracking-tight text-ink-900 dark:text-white">{title}</h2>
  {moreHref && (
    <a
      class="inline-flex items-center gap-0.5 text-xs text-ink-300 transition hover:text-brand-500 dark:text-white/50"
      href={moreHref}
    >
      {moreLabel}
      <Icon name="lucide:chevron-right" style="width:14px;height:14px" />
    </a>
  )}
</div>
