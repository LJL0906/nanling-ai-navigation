---
/** 首页 Hero：主标题 + 搜索框 + 热门搜索标签。装饰图形用 CSS/SVG 近似设计稿的 3D 渲染。 */
import { Icon } from 'astro-icon/components';
---
<section class="cyber-hero relative isolate" aria-label="站内搜索">
  <form class="cyber-search" action="/search/" method="get" role="search" data-search-history-form>
    <label for="site-search" class="sr-only">搜索网站、工具、资源</label>
    <Icon name="lucide:terminal" style="width:17px;height:17px" class="shrink-0 text-brand-500" />
    <input
      id="site-search"
      type="search"
      name="q"
      placeholder="输入关键词，开始检索..."
      autocomplete="off"
      class="h-full min-w-0 flex-1 bg-transparent text-sm text-ink-900 outline-none placeholder:text-ink-300"
    />
    <button type="submit" class="cyber-search__button" aria-label="搜索" title="搜索">
      <Icon name="lucide:arrow-right" style="width:18px;height:18px" />
    </button>
  </form>

  <div class="cyber-search-history" data-search-history hidden>
    <span class="cyber-search-history__label">
      <Icon name="lucide:history" style="width:14px;height:14px" />
      <span>历史搜索</span>
    </span>
    <div class="cyber-search-history__tags" data-search-history-tags></div>
  </div>
</section>
