---
/** 网格中的站点小卡片，整卡可点击并在新窗口打开。 */
import type { Site } from '../../lib/types';
import Card from '../ui/Card.astro';
import BrandIcon from '../ui/BrandIcon.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props;
---
<Card href={site.url} external ariaLabel={`${site.name}：${site.desc}（新窗口打开）`} class="group px-3 py-3">
  <div class="flex items-center gap-2.5">
    <BrandIcon icon={site.icon} mono={site.mono ?? site.name.charAt(0)} color={site.color} size={36} />
    <div class="min-w-0">
      <div class="truncate text-sm font-medium text-ink-900 transition-colors group-hover:text-brand-500 dark:text-white">
        {site.name}
      </div>
      <div class="truncate text-[11px] text-ink-300 dark:text-white/45">{site.desc}</div>
    </div>
  </div>
</Card>
