---
/** 六列站点网格，窄屏逐级降列。 */
import type { Site } from '../../lib/types';
import SiteCard from './SiteCard.astro';

interface Props {
  sites: Site[];
  label?: string;
}
const { sites, label } = Astro.props;
---
<ul class="grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6" aria-label={label}>
  {sites.map((site) => (
    <li><SiteCard site={site} /></li>
  ))}
</ul>
