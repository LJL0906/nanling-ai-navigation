---
/** 资讯分区沿用统一紧凑站点网格。 */
import type { Site } from '../../lib/types';
import PreviewCard from './PreviewCard.astro';

interface Props {
  sites: Site[];
  label?: string;
}
const { sites, label } = Astro.props;
---
<ul class="nav-card-grid" aria-label={label}>
  {sites.map((site) => (
    <li><PreviewCard site={site} /></li>
  ))}
</ul>

