# 复制为 .env；不要提交真实凭据，切勿使用 PUBLIC_ 前缀。
# 浏览器管理员账户：两项均需填写，无默认密码，请使用高强度独立密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 内存会话8小时有效；重启失效，多实例部署需要共享会话及限流存储。
# 登录失败全局每15分钟最多10次；生产环境必须使用 HTTPS。
# 可选：保留 API / CLI Bearer 认证，不配置也可使用账户会话。
ADMIN_TOKEN=

# 数据源：seed 保持页面可用；建表并导入成功后手动改为 mysql。
NAV_STORAGE=seed
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=navigationwebsite
MYSQL_USER=navigationWebsite
MYSQL_PASSWORD=
# 默认要求加密且验证证书；私有CA可填写本机证书绝对路径。
MYSQL_SSL_MODE=required
MYSQL_SSL_CA=

HOST=127.0.0.1
PORT=4321

# OSS 附件存储（仅服务端使用；私有对象，不改变 Bucket ACL）
OSS_REGION=oss-cn-beijing
OSS_BUCKET=wx-koi-accounting
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 使用临时 RAM 凭据时填写
OSS_SECURITY_TOKEN=


# OSS 上传防滥用；按 MySQL UTC 日期计每日额度，累计额度不自动清零。
# false 可紧急关闭新图标上传（在线图标地址、无图标提交仍可用）。
OSS_UPLOAD_ENABLED=true
OSS_UPLOAD_IP_DAILY_LIMIT=10
OSS_UPLOAD_IP_DAILY_BYTES=5242880
OSS_UPLOAD_DAILY_LIMIT=200
OSS_UPLOAD_DAILY_BYTES=104857600
OSS_UPLOAD_TOTAL_LIMIT=2000
OSS_UPLOAD_TOTAL_BYTES=1073741824
